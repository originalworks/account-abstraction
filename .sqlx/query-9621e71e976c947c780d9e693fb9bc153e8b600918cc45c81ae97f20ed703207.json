{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            ea.id,\n            ea.chain_id,\n            ea.operator_wallet_id,\n            ea.tx_type as \"tx_type: TxType\",\n            ea.nonce_used,\n            ea.tx_value,\n            ea.tx_hash,\n            ea.gas_limit,\n            ea.used_gas,\n            ea.max_fee_per_gas,\n            ea.max_priority_fee,\n            ea.max_fee_per_blob_gas,\n            ea.outcome as \"outcome: TxExecutionOutcome\",\n            ea.error_object,\n            ea.retryable,\n            ea.created_at,\n            ea.updated_at\n        FROM\n            execution_attempts ea\n        INNER JOIN\n            execution_attempt_items eai\n            ON eai.execution_attempt_id = ea.id\n        WHERE\n            eai.tx_id = $1\n        ORDER BY\n            ea.created_at DESC\n        ",
